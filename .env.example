# Подключение к PostgreSQL (docker compose: порт 5433 → 5432 контейнера)
DATABASE_URI="postgresql://postgres:postgres@localhost:5433/postgres?schema=public"

# Секрет Payload (замените на случайную строку)
PAYLOAD_SECRET=changeme

# S3/MinIO — Payload включает S3-хранилище, когда заданы ключи и endpoint.
# Перед запуском Next после подключения используйте scripts/migrate-media-to-s3.sh;
# скрипт копирует файлы в бакет и сохраняет исходные файлы media/.
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_IMAGES_BUCKET=images
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
